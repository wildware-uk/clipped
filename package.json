{
  "name": "clipped",
  "private": true,
  "description": "npm workspace root for the Clipped desktop application and the TypeScript packages it is built from",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildware-uk/clipped.git"
  },
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17.1"
  },
  "scripts": {
    "dev": "npm run dev --workspace @clipped/desktop",
    "build": "npm run build --workspace @clipped/desktop",
    "tauri": "npm run tauri --workspace @clipped/desktop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.42.0",
    "eslint": "^9.42.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
