{
  "name": "clipped",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "npm workspace root for the Clipped desktop application and the TypeScript packages it consumes.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildware-uk/clipped.git"
  },
  "engines": {
    "node": ">=22.17.1 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @clipped/desktop",
    "dev:web": "npm run dev:web --workspace @clipped/desktop",
    "build": "npm run build --workspace @clipped/desktop",
    "build:app": "npm run build:app --workspace @clipped/desktop",
    "preview": "npm run preview --workspace @clipped/desktop",
    "lint": "npm run lint:eslint && npm run lint:format && npm run typecheck",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check apps/desktop packages *.json *.js",
    "typecheck": "tsc --noEmit --project apps/desktop/tsconfig.json",
    "format": "prettier --write apps/desktop packages *.json *.js",
    "test": "npm run test --workspace @clipped/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
