# `engines.node` in package.json states the Node version this workspace is built
# and tested against, matching the pin in .nvmrc. Without this setting npm treats
# that field as advice and installs anyway, which turns "the pin is wrong" into a
# confusing failure much later - a Vite plugin that needs a newer Node, or a
# build that only reproduces on one machine. `engine-strict` makes npm refuse the
# install and say which version it wanted, which is the same bargain
# rust-toolchain.toml strikes for the Rust side.
engine-strict=true
