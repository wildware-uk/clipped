{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipped",
  "version": "0.1.0",
  "identifier": "uk.wildware.clipped",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run stage:installer-payload && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipped",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "installer-payload/": ""
    },
    "publisher": "Wildware",
    "copyright": "The Clipped contributors",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "Automatic game recorder",
    "longDescription": "Clipped records your games in the background and keeps the moments worth keeping."
  }
}
