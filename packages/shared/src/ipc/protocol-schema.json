{
  "schema_format": 1,
  "regenerate_with": "cargo run -p clipped-ipc --bin protocol-schema",
  "protocol_version": 1,
  "supported_protocol_versions": [
    1
  ],
  "framing": {
    "length_prefix_bytes": 4,
    "length_prefix_endianness": "little",
    "max_frame_bytes": 1048576
  },
  "max_concurrent_connections": 8,
  "envelopes": {
    "client": {
      "hello": "hello",
      "request": "request"
    },
    "server": {
      "event": "event",
      "refused": "protocol_error",
      "response": "response",
      "welcome": "welcome"
    }
  },
  "enumerations": {
    "client_message_type": {
      "values": [
        "hello",
        "request"
      ],
      "tolerates_unrecognised": false
    },
    "command": {
      "values": [
        "ping",
        "get_status",
        "start_recording",
        "stop_recording",
        "shutdown",
        "save_replay",
        "add_bookmark",
        "take_screenshot",
        "apply_settings"
      ],
      "tolerates_unrecognised": true
    },
    "connection_role": {
      "values": [
        "control",
        "events"
      ],
      "tolerates_unrecognised": true
    },
    "end_reason": {
      "values": [
        "stopped",
        "target_lost",
        "target_resized"
      ],
      "tolerates_unrecognised": true
    },
    "error_code": {
      "values": [
        "unsupported_protocol_version",
        "handshake_required",
        "malformed_frame",
        "unknown_command",
        "invalid_parameters",
        "not_implemented",
        "already_recording",
        "not_recording",
        "target_not_found",
        "recording_failed",
        "too_many_connections",
        "shutting_down",
        "internal"
      ],
      "tolerates_unrecognised": true
    },
    "error_detail": {
      "values": [
        "unsupported_protocol_version",
        "not_implemented"
      ],
      "tolerates_unrecognised": true
    },
    "event": {
      "values": [
        "status_changed",
        "recording_failed"
      ],
      "tolerates_unrecognised": true
    },
    "event_stream": {
      "values": [
        "status",
        "errors",
        "metrics"
      ],
      "tolerates_unrecognised": true
    },
    "feature": {
      "values": [
        "recording",
        "status_events",
        "shutdown"
      ],
      "tolerates_unrecognised": true
    },
    "outcome": {
      "values": [
        "ok",
        "error"
      ],
      "tolerates_unrecognised": false
    },
    "recorder_state": {
      "values": [
        "idle",
        "recording"
      ],
      "tolerates_unrecognised": false
    },
    "reply": {
      "values": [
        "pong",
        "status",
        "recording_started",
        "recording_stopped",
        "shutting_down"
      ],
      "tolerates_unrecognised": false
    },
    "server_message_type": {
      "values": [
        "welcome",
        "refused",
        "response",
        "event"
      ],
      "tolerates_unrecognised": false
    }
  },
  "structures": {
